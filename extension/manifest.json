{
  "manifest_version": 3,
  "name": "ClearLead Application Copilot",
  "version": "0.8.1",
  "description": "Captures user-cleared job evidence, fills safe fields from local ClearLead data, and never submits forms.",
  "permissions": ["activeTab", "storage", "sidePanel"],
  "host_permissions": ["http://127.0.0.1:4173/*", "http://localhost:4173/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open ClearLead Application Copilot" },
  "side_panel": { "default_path": "popup.html" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["adapters.js", "content.js"], "run_at": "document_idle" }]
}
